# Optional. Leave empty to keep the bundled local admin UI open.
#
# When set, /admin uses browser HTTP Basic Auth with username `admin` and this
# value as the password. Admin API clients may also send the same value through
# `x-partymaker-admin-secret` or `Authorization: Bearer <value>`.
# This is server-only: never rename it with a NEXT_PUBLIC_ prefix.
PARTYMAKER_ADMIN_SECRET=
