# Optional. Leave empty for the bundled local admin UI.
#
# When set, admin views and non-guest commands must include this value in either
# `x-partymaker-admin-secret` or `Authorization: Bearer <value>`.
# This is server-only: never rename it with a NEXT_PUBLIC_ prefix.
# The current admin page does not prompt for or send this value.
PARTYMAKER_ADMIN_SECRET=
