{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partymaker",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/cloudflare/worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PARTY_EVENTS",
        "class_name": "PartyEventDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PartyEventDurableObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
